{
  "name": "eagle-culling-pipeline",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first, reviewable photo culling workflow for Eagle",
  "type": "module",
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "inventory": "node src/cli.js inventory",
    "analyze": "node src/cli.js analyze",
