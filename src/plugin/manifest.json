{
  "id": "eagle-culling",
  "version": "1.4.1",
  "platform": "all",
  "arch": "all",
  "name": "Eagle照片筛选",
  "logo": "/logo.png",
  "keywords": [
    "photo",
    "culling"
  ],
  "devTools": false,
  "main": {
    "url": "index.html",
    "width": 420,
    "height": 600,
    "minWidth": 360,
    "minHeight": 480,
    "resizable": true,
    "frame": true,
    "fullscreenable": true,
    "serviceMode": true
  },
  "preview": {
    "jpg,jpeg,png,webp,tif,tiff,bmp,arw,dng,3fr,cr2,cr3,crw,nef,nrw,raf,orf,rw2,pef,srw,sr2,srf,erf,iiq,x3f,kdc,dcr,mef,mos,mrw,rwl,raw,heic,heif,hif": {
      "inspector": {
        "path": "inspector/index.html",
        "height": 760,
        "multiSelect": true
      }
    }
  }
}
